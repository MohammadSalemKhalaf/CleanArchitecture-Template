# Local Docker Compose settings. Copy to .env and replace every <placeholder>.
# .env is git-ignored and docker-ignored. Never commit real values.

# --- API ---------------------------------------------------------------------
API_PORT=8080
# Development enables the OpenAPI document and the Scalar UI at /scalar.
ASPNETCORE_ENVIRONMENT=Development

# --- SQL Server --------------------------------------------------------------
# 8+ characters with upper case, lower case, digits and symbols, or SQL Server refuses to start.
DB_SA_PASSWORD=<sql-server-sa-password>
DB_NAME=TemplateApp
DB_PORT=1433

# --- Redis / Seq ---------------------------------------------------------------
REDIS_PORT=6379
SEQ_UI_PORT=8081
SEQ_INGESTION_PORT=5341

# --- Token validation ----------------------------------------------------------
# Self-signed HMAC tokens for local use. README > "Authentication" shows how to create the key and a token.
# In production, point the API at your identity provider instead (Authentication__Schemes__Bearer__Authority).
JWT_ISSUER=templateapp-local
JWT_AUDIENCE=templateapp-api
JWT_SIGNING_KEY=<base64-encoded-key-of-at-least-32-bytes>
