# Server-side application settings for deploy/docker-compose.prod.yml.
# Create this file as <DEPLOY_PATH>/.env on the server (chmod 600). It is never stored in the repository or in CI.

# --- Database (required) ----------------------------------------------------------
ConnectionStrings__Database=Server=<host>,1433;Database=<database>;User Id=<user>;Password=<password>;Encrypt=True

# --- Token validation (required) ---------------------------------------------------
# Option A, recommended: an OpenID Connect identity provider.
Authentication__Schemes__Bearer__Authority=https://<your-identity-provider>
Authentication__Schemes__Bearer__ValidAudiences__0=<api-audience>
# Option B: self-issued HMAC tokens (remove the Authority line above).
# Authentication__Schemes__Bearer__ValidIssuer=<issuer>
# Authentication__Schemes__Bearer__ValidAudiences__0=<api-audience>
# Authentication__Schemes__Bearer__SigningKeys__0__Issuer=<issuer>
# Authentication__Schemes__Bearer__SigningKeys__0__Value=<base64-key>

# --- Logging (optional) -----------------------------------------------------------
# Serilog__WriteTo__Seq__Name=Seq
# Serilog__WriteTo__Seq__Args__serverUrl=https://<seq-host>
# Serilog__WriteTo__Seq__Args__apiKey=<seq-api-key>

# --- Host -------------------------------------------------------------------------
API_PORT=8080
