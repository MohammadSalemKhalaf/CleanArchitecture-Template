{
  "OpenApi": {
    "Enabled": true
  },
  "Database": {
    "InitializeOnStartup": true,
    "SeedSampleData": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "TemplateApp": "Debug"
      }
    },
    "WriteTo": {
      "Seq": {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    }
  }
}
